{
  "name": "unipal-backend",
  "version": "1.0.0",
  "description": "Backend API para UniPal-AI",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "dev:nodemon": "nodemon --watch src --ext ts --exec tsx src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node --esm prisma/seed.ts",
    "seed": "prisma db seed",
    "update-passwords": "tsx actualizar-contrasenas.ts"
  },
  "keywords": [
    "unipal",
    "education",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^11.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mssql": "^4.1.12",
    "@types/node": "^20.14.10",
    "nodemon": "^3.1.0",
    "prisma": "^5.19.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.5.3"
  },
  "prisma": {
    "seed": "ts-node --esm prisma/seed.ts"
  }
}
